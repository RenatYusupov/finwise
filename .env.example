# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://finwise:finwise@localhost:5432/finwise
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT_SECRET — required by auth-service (min 32 chars, keep secret)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
# BOT_TOKEN — same as TELEGRAM_BOT_TOKEN, used by auth-service for initData HMAC validation
BOT_TOKEN=your_bot_token_here

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ── AI ────────────────────────────────────────────────────────────────────────
# Groq API key — get from https://console.groq.com/keys
# NEVER put this in client-side code — backend only (ai-service)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finwise_context

# ── Services ──────────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
FINANCE_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_TMA_DEBUG=true

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
